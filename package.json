    "test": "echo \"Error: no test specified\" && exit 1",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:chrome": "cypress run --browser chrome",
    "cypress:run:headed": "cypress run --browser chrome --headed",
    "cypress:run:qauto": "cypress run --config-file cypress.config.qauto.js",
    "cypress:run:qauto2": "cypress run --config-file cypress.config.qauto2.js",
    "cypress:open:qauto": "cypress open --config-file cypress.config.qauto.js",
    "cypress:open:qauto2": "cypress open --config-file cypress.config.qauto2.js",
    "report:merge": "mochawesome-merge \"cypress/reports/**/*.json\" > cypress/reports/output.json",
    "report:generate": "npx marge cypress/reports/output.json --reportDir cypress/reports/html"
  },
